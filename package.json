{
  "name": "wheretoi-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "android:apk": "node scripts/build-android-apk.mjs",
    "ios:add": "npm run build && npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:run": "npm run ios:sync && npx cap run ios",
    "check": "node scripts/check.mjs",
    "check:browser": "playwright test",
    "repair:postgres": "node --disable-warning=ExperimentalWarning scripts/repair-postgres.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "check:e2e": "node --disable-warning=ExperimentalWarning scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.13.0",
    "pg": "^8.21.0"
  },
  "engines": {
    "node": ">=22.5.0 <27"
  },
  "devDependencies": {
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.1",
    "@playwright/test": "^1.60.0"
  }
}
